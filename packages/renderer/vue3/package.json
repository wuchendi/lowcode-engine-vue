{
  "name": "@cdlab996/lowcode-vue3",
  "type": "module",
  "version": "1.2.0",
  "description": "LowCode Engine renderer and designer simulator for Vue 3.",
  "author": "wudi <wuchendi96@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/wuchendi/lowcode-engine-vue/tree/main/packages/renderer/vue3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchendi/lowcode-engine-vue.git",
    "directory": "packages/renderer/vue3"
  },
  "bugs": {
    "url": "https://github.com/wuchendi/lowcode-engine-vue/issues"
  },
  "keywords": [
    "vue",
    "lowcode",
    "lowcode-engine"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./designer": {
      "types": "./dist/designer.d.mts",
      "default": "./dist/designer.mjs"
    },
    "./simulator.css": "./dist/simulator.css",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/renderer.umd.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:type": "tsc -p ./tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@cdlab996/lowcode-vue-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.2.0 || ^5.0.0"
  },
  "devDependencies": {
    "@alilc/lowcode-designer": "catalog:shared",
    "@cdlab996/lowcode-tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "vue": "catalog:vue3",
    "vue-router": "catalog:vue3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

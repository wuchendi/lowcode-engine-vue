{
  "name": "@cdlab996/lowcode-vue-simulator-renderer",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://github.com/wuchendi/lowcode-engine-vue/tree/main/packages/vue3/simulator-renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchendi/lowcode-engine-vue.git",
    "directory": "packages/vue3/simulator-renderer"
  },
  "bugs": {
    "url": "https://github.com/wuchendi/lowcode-engine-vue/issues"
  },
  "keywords": [
    "vue",
    "lowcode",
    "lowcode-engine"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "lint:type": "tsc -p ./tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@cdlab996/lowcode-hooks": "workspace:*",
    "@cdlab996/lowcode-utils": "workspace:*",
    "@cdlab996/lowcode-vue-renderer": "workspace:*"
  },
  "peerDependencies": {
    "@alilc/lowcode-types": "^1.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@alilc/lowcode-designer": "catalog:shared",
    "@alilc/lowcode-types": "catalog:shared",
    "tsdown": "catalog:dev",
    "vue": "catalog:vue3",
    "vue-router": "catalog:vue3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

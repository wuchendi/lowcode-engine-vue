{
  "name": "@cdlab996/lowcode-vue-simulator-renderer2.7",
  "type": "module",
  "version": "1.0.0",
  "description": "Lowcode simulator renderer using vue2.7 engine",
  "author": "wudi <wuchendi96@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/wuchendi/lowcode-engine-vue/tree/main/packages/vue2-7/simulator-renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchendi/lowcode-engine-vue.git",
    "directory": "packages/vue2-7/simulator-renderer"
  },
  "bugs": {
    "url": "https://github.com/wuchendi/lowcode-engine-vue/issues"
  },
  "keywords": [
    "vue",
    "lowcode",
    "lowcode-engine"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      }
    },
    "./dist/*": "./dist/*"
  },
  "main": "./dist/runtime.mjs",
  "module": "./dist/runtime.mjs",
  "types": "./dist/runtime.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "lint:type": "tsc -p ./tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@cdlab996/lowcode-hooks2.7": "workspace:*",
    "@cdlab996/lowcode-utils2.7": "workspace:*",
    "@cdlab996/lowcode-vue-renderer2.7": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">= 2.7.x < 3",
    "vue-router": ">= 3.6.x < 4"
  },
  "peerDependenciesMeta": {
    "@alilc/lowcode-designer": {
      "optional": true
    },
    "@alilc/lowcode-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alilc/lowcode-designer": "catalog:shared",
    "@alilc/lowcode-shell": "catalog:shared",
    "@alilc/lowcode-types": "catalog:shared",
    "tsdown": "catalog:dev",
    "vue": "catalog:vue2-7",
    "vue-router": "catalog:vue2-7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
